{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "out",
    "rootDir": "src",
    "types": ["node"]
    // No `paths` here on purpose. This project is emitted by plain `tsc`, which
    // typechecks aliases but does not rewrite them — `@shared/boot` would
    // survive into out/cli as a literal require() and throw at runtime. The CLI
    // uses relative imports.
  },
  // Of src/shared, only what a windowed launch has to agree on: the boot
  // config and the app settings it can set. The rest is Electron's side of
  // the app, which the CLI never loads.
  "include": ["src/cli/**/*", "src/core/**/*", "src/shared/boot.ts", "src/shared/types.ts"]
}
