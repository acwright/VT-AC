{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // Jest's project. `paths` is safe here — unlike the CLI's plain-tsc emit,
    // nothing is emitted, and jest.config.cjs mirrors these in moduleNameMapper.
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/src/*"],
      "@core/*": ["src/core/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": [
    "src/core/**/*",
    "src/cli/**/*",
    "src/shared/boot.ts",
    "src/shared/types.ts",
    // Not the whole renderer — Vue components are driven, not unit-tested. But
    // a service with logic of its own is testable like anything else, and a
    // test that imports one needs the `window.api` declaration to compile.
    "src/renderer/src/env.d.ts",
    "src/tests/**/*"
  ]
}
