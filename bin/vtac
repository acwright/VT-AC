#!/usr/bin/env node
// Dev entry point for the vtac CLI.
//
// The installed `vtac` is a shim that runs the CLI bundled inside the app,
// through Electron's own Node — see src/main/cliShim.ts — so no separate
// runtime is needed. From a checkout, build with `npm run build:cli`, which
// `npm run cli` does for you.
'use strict'

const { existsSync } = require('node:fs')
const { join } = require('node:path')

const entry = join(__dirname, '..', 'out', 'cli', 'index.js')

if (!existsSync(entry)) {
  process.stderr.write('vtac: CLI is not built yet — run `npm run build:cli`\n')
  process.exit(1)
}

require(entry)
